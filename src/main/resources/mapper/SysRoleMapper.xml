<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.SysRoleMapper">

    <select id="selectRolesByUserId" resultType="com.example.demo.entity.SysRole">
        SELECT r.* FROM sys_role r
        JOIN sys_user_role ur ON r.id = ur.role_id
        WHERE ur.user_id = #{userId}
    </select>

    <select id="selectByCode" resultType="com.example.demo.entity.SysRole">
        SELECT * FROM sys_role WHERE role_code = #{roleCode}
    </select>

</mapper>
